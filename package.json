{
  "name": "alysiscode-bulk-apikey",
  "version": "1.0.0",
  "description": "Bulk-create Alysis Code accounts and mint one hosted gateway key per account (slk_...) — OpenAI-compatible inference behind the Alysis Code LLM gateway, plus a 9Router connector.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "alysiscode-bulk-apikey": "src/cli.js",
    "alysiscode-bulk-apikey-launcher": "src/launcher.js"
  },
  "main": "src/cli.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/launcher.js",
    "mint": "node src/cli.js --auto",
    "9router": "node src/connect-9router.js",
    "omniroute": "node src/connect-omniroute.js"
  },
  "keywords": [
    "api-key",
    "bulk",
    "register",
    "launcher",
    "alysiscode",
    "apikey"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "ADVANCED.md"
  ],
  "dependencies": {
    "puppeteer-core": "^24.10.0"
  }
}
